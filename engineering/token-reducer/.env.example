# token-reducer — optional environment variables.
# The default "hash" embedding backend needs NONE of these; both the CLI
# (scripts/context_pipeline.py) and the experimental MCP server run with
# zero configuration out of the box.

# Override the default SQLite index location (otherwise: .cache/index.db)
TOKEN_REDUCER_DB=.cache/index.db

# Override the default embedding backend: hash | tfidf
TOKEN_REDUCER_EMBEDDING_BACKEND=hash
